{
  "name": "delta-comic-plugin-layout",
  "private": true,
  "description": "Delta Comic 的基础内容布局插件",
  "homepage": "https://github.com/delta-comic/delta-comic-plugin-layout",
  "bugs": {
    "url": "https://github.com/delta-comic/delta-comic-plugin-layout/issues",
    "email": "wenxinguo12@gmail.com"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "wenxig",
    "email": "wenxinguo12@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/delta-comic/delta-comic-plugin-layout.git"
  },
  "type": "module",
  "scripts": {
    "artifacts": "node ./script/artifacts.mts",
    "branch:develop": "node ./script/release-branches.mts develop",
    "branch:develop:dry-run": "node ./script/release-branches.mts develop --dry-run",
    "build": "vp run --filter @delta-comic/plugin-layout build",
    "check": "vp check",
    "dev": "vp run --filter @delta-comic/plugin-layout dev",
    "lib-build": "vp run --filter @delta-comic/plugin-layout build",
    "release": "vp exec semantic-release",
    "release:dry-run": "vp exec semantic-release --dry-run",
    "release:preview": "node ./script/release-branches.mts preview",
    "release:preview:dry-run": "node ./script/release-branches.mts preview --dry-run",
    "release:stable": "node ./script/release-branches.mts stable",
    "release:stable:dry-run": "node ./script/release-branches.mts stable --dry-run",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && vp run --filter @delta-comic/plugin-layout typecheck",
    "vp:install": "vp install"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "commitlint-plugin-cspell": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "jszip": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "badges": [
    {
      "description": "semantic-release: angular",
      "href": "https://github.com/semantic-release/semantic-release",
      "url": "https://img.shields.io/badge/semantic--release-angular-e10079?logo=semantic-release"
    },
    {
      "description": "Repo License",
      "href": "https://github.com/delta-comic/delta-comic-plugin-layout/blob/main/LICENSE",
      "url": "https://img.shields.io/github/license/delta-comic/delta-comic-plugin-layout"
    },
    {
      "description": "GitHub Downloads (all assets, all releases)",
      "href": "https://github.com/delta-comic/delta-comic-plugin-layout/releases/latest",
      "url": "https://img.shields.io/github/downloads/delta-comic/delta-comic-plugin-layout/total"
    }
  ],
  "packageManager": "pnpm@11.18.0",
  "readme": "./README.md"
}